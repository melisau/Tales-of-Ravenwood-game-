{
  "name": "ravenwood-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tales of Ravenwood — gerçek zamanlı co-op FRP oyun sunucusu",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0"
  }
}
